{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "properties": {
      "chunkId": { "type": "long" },
      "documentId": { "type": "long" },
      "chunkIndex": { "type": "integer" },
      "title": { "type": "keyword" },
      "heading": { "type": "keyword" },
      "content": {
        "type": "text",
        "analyzer": "${analyzer}",
        "search_analyzer": "${searchAnalyzer}"
      }
    }
  }
}
