# ===== 数据库 =====
# 与 docker-compose 的 postgres 服务对齐
DATABASE_URL=postgresql+asyncpg://recordandgrow:recordandgrow@localhost:5432/recordandgrow

# ===== 对话模型（DeepSeek，OpenAI 兼容）=====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro

# ===== Embedding（DashScope 兼容模式，text-embedding-v4）=====
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ===== 重排（DashScope，可选）=====
RERANK_ENABLED=false
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=gte-rerank-v2

# ===== 功能开关（默认与 Java 版对齐）=====
AGENT_ENABLED=true
GRAPH_ENABLED=true
MEMORY_ENABLED=true
MEMORY_EXTRACTION_ENABLED=true
MCP_ENABLED=true
SKILLS_ENABLED=true
FUSION_ENABLED=false
KEYWORD_ENABLED=false
ROUTING_ENABLED=false

# ===== 技能目录 =====
SKILLS_DIR=./skills

# ===== MCP 鉴权（可选）=====
# 非空时 /mcp 要求 Authorization: Bearer <token>；公网暴露时必须设置
MCP_AUTH_TOKEN=
